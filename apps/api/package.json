{
  "name": "@content/api",
  "version": "0.6.0",
  "private": true,
  "bin": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json --clear-screen=false --exclude ../../packages/shared/dist/** src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretest": "npm run build -w @content/shared",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pkg": {
    "assets": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ]
  },
  "dependencies": {
    "@content/shared": "file:../../packages/shared",
    "@libsql/client": "0.17.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcrypt": "^5.1.1",
    "cheerio": "1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "exceljs": "4.4.0",
    "openai": "^6.37.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0"
  }
}
