# Database
DATABASE_URL="file:./prisma/dev.db"

# Content source
CONTENT_DATA_SOURCE="jeesite"
LOCAL_LIFE_API_BASE_URL="http://localhost:3000/api"
EXTERNAL_API_BASE_URL="https://zdm.zhsh1.cn/a"
EXTERNAL_PACKAGES_PATH="/bargain/bargainCommodity/listData?pageSize=100&pageNo=1"
# 门店管理刷新：读取合作商店铺 listData，按外部门店 ID 幂等同步坐标
EXTERNAL_PARTNER_SHOPS_PATH="/core/corePartnerShop/listData?pageSize=100&pageNo=1"
EXTERNAL_API_TOKEN=""
EXTERNAL_API_COOKIE=""
EXTERNAL_API_USERNAME=""
EXTERNAL_API_PASSWORD=""
# 用户中心会员目录刷新：单线程逐页拉取，刷新失败保留上次成功快照
EXTERNAL_MEMBER_FETCH_TIMEOUT_MS="8000"
USER_CENTER_REFRESH_PAGE_SIZE="500"
USER_CENTER_REFRESH_INTERVAL_MS="1000"
# API 启动后自动触发一次受控会员目录同步；设为 false 可关闭
USER_CENTER_REFRESH_ON_STARTUP="true"
# 合作商店铺刷新：串行逐页拉取，全部页面成功后才原子更新本地门店快照
PARTNER_SHOP_REFRESH_PAGE_SIZE="100"
PARTNER_SHOP_REFRESH_INTERVAL_MS="500"
# 福利金记录刷新严格单线程；每页请求之间默认等待 1 秒
EXTERNAL_WELFARE_FETCH_INTERVAL_MS="1000"
# 用户积分记录：只抓取用户当前打开的页，沿用外部会员接口的串行请求队列
EXTERNAL_INTEGRAL_RECORDS_PATH="/member/centerMemberIntegralRecord/listData"

# AI
AI_PROVIDER="template"
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# Claude Code / Anthropic-compatible gateway (e.g. aisenyu)
# Claude Code reads these from ~/.claude/settings.json env{} or the process environment.
# Do NOT commit real keys. Put them in local .env or Claude Code private settings.
# ANTHROPIC_BASE_URL=https://api.aisenyu.com
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=grok-4.5
# Optional OpenAI-compatible project AI (same gateway)
# AI_API_BASE_URL=https://api.aisenyu.com/v1
# AI_API_KEY=
# AI_MODEL=grok-4.5
#
# Codex CLI (OpenAI-compatible /v1/responses) — same gateway
# Preferred: store key in ~/.codex/auth.json via:
#   printf '%s' "$OPENAI_API_KEY" | codex login --with-api-key
# And set ~/.codex/config.toml:
#   model_provider="custom", model="grok-4.5", review_model="grok-4.5"
#   [model_providers.custom]
#   base_url="https://api.aisenyu.com/v1", wire_api="responses", requires_openai_auth=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.aisenyu.com/v1
# See docs/CODEX-AISENYU.md

# Server
# APP_RUNTIME 可选值：development | server。Desktop 主进程会强制注入 desktop。
# APP_RUNTIME="development"
PORT="3100"
HOST="127.0.0.1"

# Authentication (JWT)
# 默认开发账号是 admin / contentops2024 (在 apps/api/src/config/auth.config.ts 定义)
# 生产环境必须自定义（默认值会被 NestJS 拒绝启动）
AUTH_USERNAME="admin"
AUTH_PASSWORD="contentops2024"
JWT_SECRET=""

# IAM compatibility rollout: compare legacy and IAM authorization without changing legacy route decisions.
IAM_SHADOW_MODE="true"

# Performance tuning
CONTENT_CACHE_TTL_MS="300000"
EXTERNAL_FETCH_TIMEOUT_MS="8000"
EXTERNAL_FETCH_CONCURRENCY="2"

# Authentication (JWT)
# AUTH_USERNAME — 登录用户名，默认 admin
# AUTH_PASSWORD — 登录密码，生产环境必须自定义（默认值会拒绝启动）
# JWT_SECRET   — JWT 签名密钥，生产环境必须自定义（默认值会拒绝启动）
# AUTH_USERNAME="admin"
# AUTH_PASSWORD=""
# JWT_SECRET=""

# Soldout collect token — POST /api/content/soldout-links/collect 的内部调用 token
# 定时任务 (scripts/collect-soldout.ps1) 必须传 x-internal-token
# 必须设置,否则该端点会拒绝所有请求（401）
# SOLDOUT_COLLECT_TOKEN=""

# Web (Vite) - 本地开发统一从 http://localhost:3100 打开
# - VITE_API_BASE_URL：前端请求基址，保持 /api 即可使用同端口代理
# - VITE_API_PROXY_TARGET：本地开发时 /api 代理到内部 API（npm run dev 会自动设为 http://localhost:3101）
# - VITE_DEV_SERVER_PORT：本地开发公开入口端口
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://localhost:3101"
VITE_DEV_SERVER_PORT="3100"

# CORS — comma-separated extra browser origins allowed by the API
# Defaults already include localhost/127.0.0.1 on PORT and Vite 3100.
# CORS_ORIGINS="http://localhost:5173"

# Reverse proxy — set when the API sits behind nginx/caddy so req.ip is the client IP.
# Leave unset for direct binds (clients cannot spoof X-Forwarded-For).
# Values: true|1|yes (trust 1 hop) or a hop count (e.g. 2).
# TRUST_PROXY=true

# Debug HTML endpoints (admin only) — disabled in production unless true.
# ENABLE_DEBUG_ENDPOINTS=false
