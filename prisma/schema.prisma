generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrganizationUnitType {
  HEADQUARTERS
  REGION
  MERCHANT
}

enum RoleScopeType {
  ALL
  ORG_TREE
  ORG_ONLY
  NONE
}

// ── Tenant / organization / permission center (V0.11) ────────────────

model Tenant {
  tenantId    String   @id
  tenantKey   String   @unique
  name        String
  status      String   @default("active")
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationUnits OrganizationUnit[]
  roles             Role[]
  memberships       UserOrganizationMembership[]
  roleAssignments   UserRoleAssignment[]

  @@index([status])
}

model OrganizationUnit {
  unitId      String               @id
  tenantId    String
  parentId    String?
  code        String
  name        String
  unitType    OrganizationUnitType
  areaId      String?
  merchantId  String?
  isActive    Int                  @default(1)
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant      Tenant                    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  parent      OrganizationUnit?         @relation("OrganizationUnitTree", fields: [parentId], references: [unitId], onDelete: Restrict)
  children    OrganizationUnit[]        @relation("OrganizationUnitTree")
  memberships UserOrganizationMembership[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, unitType, isActive])
  @@index([areaId])
  @@index([merchantId])
}

model Permission {
  permissionId String   @id
  code         String   @unique
  name         String
  description  String?
  isSystem     Int      @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([isSystem])
}

model Role {
  roleId           String   @id
  tenantId         String
  code             String
  name             String
  description      String?
  isSystemTemplate Int      @default(0)
  isActive         Int      @default(1)
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  permissions  RolePermission[]
  assignments  UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model RolePermission {
  roleId       String
  permissionId String
  granted      Int      @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserOrganizationMembership {
  membershipId String   @id
  tenantId     String
  userId       String
  orgUnitId    String
  isPrimary    Int      @default(0)
  isActive     Int      @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user    AppUser          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orgUnit OrganizationUnit @relation(fields: [orgUnitId], references: [unitId], onDelete: Cascade)

  @@unique([tenantId, userId, orgUnitId])
  @@index([userId, isActive])
  @@index([orgUnitId, isActive])
}

model UserRoleAssignment {
  assignmentId String        @id
  tenantId     String
  userId       String
  roleId       String
  scopeType    RoleScopeType @default(NONE)
  orgUnitId    String?
  isActive     Int           @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user    AppUser           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role    Role              @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  orgUnit OrganizationUnit? @relation(fields: [orgUnitId], references: [unitId], onDelete: SetNull)

  @@index([tenantId, userId, isActive])
  @@index([roleId, isActive])
  @@index([orgUnitId, scopeType])
}

model ContentPackage {
  packageId                String            @id
  packageName              String
  packageType              String
  merchantId               String
  merchantName             String
  areaId                   String
  areaName                 String
  category                 String
  commissionRate           Float
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段，Phase 1 新增 / Phase 2 回填 ──
  originalPriceFen         BigInt?
  salePriceFen             BigInt?
  welfarePriceFen          BigInt?
  temporarySalePriceFen    BigInt?
  grossProfitFen           BigInt?
  stockTotal               Int
  stockLeft                Int
  startTime                DateTime
  endTime                  DateTime
  useRules                 String
  sellingPoints            String
  saleStatus               String?
  /// JeeSite 店铺 ID（drift 治理时从活加列收编，2026-07-27）
  shopId                   String?
  /// 商家地址原文（drift 治理时从活加列收编，2026-07-27）
  merchantAddress          String?
  fallbackPackageId        String?
  miniProgramPath          String
  detailSummary            String?
  merchantCooperationScore Float
  areaMatchScore           Float
  timeMatchScore           Float
  historyScore             Float
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  snapshots                SalesSnapshot[]
  scores                   PromotionScore[]
  generatedCopies          GeneratedCopy[]
  performances             CopyPerformance[]

  @@index([areaId])
  @@index([merchantId])
  @@index([saleStatus])
  @@index([category])
  @@index([areaId, saleStatus])
  // Hot inventory predicates: stockLeft > 0 across movement/zero-sales/overview.
  @@index([stockLeft])
  @@index([stockLeft, merchantId])
  @@index([areaId, stockLeft])
}

model Merchant {
  merchantId   String   @id
  merchantName String   @default("")
  areaId       String?
  areaName     String?
  address      String?  @default("")
  lat          Float?
  lng          Float?
  totalSku     Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@index([areaId])
  @@index([merchantName])
}

model SalesSnapshot {
  id                  String         @id @default(cuid())
  packageId           String
  areaId              String
  merchantId          String
  snapshotTime        DateTime
  exposureCount       Int
  clickCount          Int
  orderCount          Int
  paidOrderCount      Int
  refundCount         Int
  verifyCount         Int
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen              BigInt?
  paidAmountFen       BigInt?
  paidAmountOnlineFen BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  conversionRate      Float
  verifyRate          Float
  refundRate          Float
  sellThroughRate     Float
  remainingStock      Int
  salesSpeed          Float
  createdAt           DateTime       @default(now())
  package             ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, snapshotTime])
  @@index([areaId])
  @@index([snapshotTime])
  @@index([merchantId])
}

model PromotionScore {
  id                  String         @id @default(cuid())
  packageId           String
  areaId              String
  score               Float
  level               String
  status              String
  recommendedStrategy String
  reason              String
  riskTips            String
  recommendedChannels String
  copyAngles          String
  calculatedAt        DateTime
  createdAt           DateTime       @default(now())
  package             ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, calculatedAt])
  @@index([areaId])
}

model GeneratedCopy {
  contentId       String            @id
  packageId       String
  areaId          String
  merchantId      String
  channel         String
  scenario        String
  title           String
  body            String
  cta             String
  copyVersion     String
  strategyType    String
  riskLevel       String
  riskTips        String
  auditStatus     String
  auditRemark     String?
  createdBy       String
  versionNo       Int               @default(1)
  sourceContentId String?
  isReusable      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package         ContentPackage    @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  performances    CopyPerformance[]

  @@index([auditStatus])
  @@index([packageId])
  @@index([areaId])
  @@index([auditStatus, channel])
  // List filters auditStatus+channel with ORDER BY createdAt DESC (90d window).
  @@index([auditStatus, channel, createdAt])
  @@index([createdAt])
}

model CopyPerformance {
  id             String         @id @default(cuid())
  contentId      String
  packageId      String
  channel        String
  groupId        String?
  leaderId       String?
  taskId         String?
  exposureCount  Int
  clickCount     Int
  orderCount     Int
  paidOrderCount Int
  verifyCount    Int
  refundCount    Int
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen         BigInt?
  conversionRate Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  package        ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  generatedCopy  GeneratedCopy? @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@index([contentId])
  @@index([packageId])
  @@index([channel])
  @@index([groupId])
  // Dashboard clamps reads to 90d; retention purge + age filters use createdAt.
  @@index([createdAt])
  // Dashboard package perf: packageId IN (...) ORDER BY createdAt DESC.
  @@index([packageId, createdAt])
}

model JeeSiteInventoryDailySnapshot {
  packageId      String
  snapshotDate   String
  snapshotTime   DateTime
  packageName    String
  merchantName   String
  areaName       String
  saleStatus     String?
  remainingStock Int
  soldOut        Boolean
  sourceField    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([packageId, snapshotDate])
  @@index([snapshotDate])
}

model OperationAlertResolution {
  alertId      String
  resolvedDate String
  resolvedBy   String?
  resolvedAt   DateTime @default(now())

  @@id([alertId, resolvedDate])
  @@index([resolvedDate])
}

model DailyMetrics {
  date                String   @id
  refundRate          Float    @default(0)
  verifyRate          Float    @default(0)
  totalOrders         Int      @default(0)
  paidOrderCount      Int      @default(0)
  verifyCount         Int      @default(0)
  refundCount         Int      @default(0)
  activeMerchants     Int      @default(0)
  activeMembers       Int      @default(0)
  movingSkus          Int      @default(0)
  stagnantSkus        Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  totalGmvFen         BigInt?
  gmvOnlineFen        BigInt?
  gmvWalletFen        BigInt?
  gmvBonusFen         BigInt?
  gmvCardFen          BigInt?
  totalRefundFen      BigInt?
  totalVerifyFen      BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountWalletFen BigInt?
  updatedAt           DateTime @updatedAt
}

model OrderHeader {
  orderId             String    @id
  /// JeSite 展示单号（导出「订单编号」，形如 K2026…）；主键仍是雪花 id
  orderCode           String?
  memberId            String?
  packageId           String?
  merchantId          String?
  merchantName        String?
  areaId              String?
  areaName            String?
  /// 业务员姓名（JeSite 砍价订单导出「业务员」）
  salesman            String?
  /// 上级业务员姓名（导出「上级业务员」）
  parentSalesman      String?
  /// 优惠券文案（导出「优惠券」）
  coupon              String?
  orderTime           DateTime
  paidTime            DateTime?
  verifyTime          DateTime?
  refundTime          DateTime?
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  orderAmountFen      BigInt?
  paidAmountFen       BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  pointEarned         Int       @default(0)
  pointUsed           Int       @default(0)
  status              String
  channel             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([memberId, orderTime])
  @@index([packageId])
  // Attribution recompute: packageId equality + orderTime range in one plan.
  @@index([packageId, orderTime])
  @@index([orderTime])
  @@index([merchantId])
  @@index([merchantName])
  @@index([merchantName, orderTime])
  @@index([orderCode])
  @@index([salesman])
  @@index([status])
  @@index([paidTime])
  // Refund/verify day totals + top-merchant metric filters.
  @@index([refundTime])
  @@index([verifyTime])
  // Direct attribution: memberId + packageId equality + orderTime range.
  @@index([memberId, packageId, orderTime])
}

model Member {
  memberId         String    @id
  nickname         String?
  phone            String?
  level            String?
  pointsBalance    Int       @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  walletBalanceFen BigInt?
  totalGmvFen      BigInt?
  firstOrderAt     DateTime?
  lastOrderAt      DateTime?
  totalOrders      Int       @default(0)
  tags             String?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @updatedAt

  pointLedgers MemberPointLedger[]
  orderPoints  OrderPoint[]

  @@index([phone])
  @@index([lastOrderAt])
  @@index([level])
}

model MemberPointLedger {
  id         String   @id @default(cuid())
  memberId   String
  orderId    String?
  delta      Int
  balance    Int
  reason     String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@index([memberId, occurredAt])
  @@index([reason])
  @@index([orderId])
}

model OrderPoint {
  id        String   @id @default(cuid())
  orderId   String
  memberId  String
  delta     Int
  type      String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, type])
  @@index([memberId])
}

model RepurchaseCohort {
  cohortMonth   String   @id
  totalMembers  Int      @default(0)
  repeat30Count Int      @default(0)
  repeat60Count Int      @default(0)
  repeat90Count Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model MerchantDailyMetrics {
  merchantName        String
  date                String
  areaName            String?
  paidOrderCount      Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  paidAmountOnlineFen BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  orderCount          Int      @default(0)
  packageCount        Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@id([merchantName, date])
  @@index([date])
  @@index([merchantName, date])
}

// Daily package sales derived from inventory diffs / order ETL.
// Live DBs may still carry a legacy "revenue" column; readers prefer salesAmount.
model PackageSalesDaily {
  id             String   @id @default(cuid())
  packageId      String
  date           String
  salesQty       Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  salesAmountFen BigInt?
  refundQty      Int      @default(0)
  deltaSource    String?
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([packageId, date])
  @@index([date])
  @@index([packageId, date])
  // Hot "sold recently" filters: date range + salesQty > 0 (movement / zero-sales / overview).
  @@index([date, salesQty])
  @@index([packageId, salesQty, date])
}

model RuleConfig {
  id         String   @id @default(cuid())
  tenantId   String?
  merchantId String?
  type       String
  name       String
  version    Int
  isActive   Boolean
  payload    String
  comment    String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, merchantId, type])
  @@index([isActive])
  // Hot resolve: merchantId + type + isActive + version DESC (platform merchantId=null too).
  @@index([merchantId, type, isActive, version])
}

model AppUser {
  userId       String   @id
  username     String   @unique
  passwordHash String
  displayName  String
  email        String?
  phone        String?
  isActive     Int      @default(1)
  /// Bumped on password reset so live JWTs / refresh are refused.
  tokenVersion Int      @default(0)
  tenantId     String   @default("tenant_default")
  primaryOrgUnitId String?
  lastLoginAt  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bindings  UserRoleBinding[]
  auditLogs OperationAuditLog[]
  organizationMemberships UserOrganizationMembership[]
  roleAssignments        UserRoleAssignment[]

  @@index([username])
  @@index([createdAt])
}

model UserRoleBinding {
  id        String   @id
  userId    String
  role      String
  scopeType String?
  scopeId   String?
  createdAt DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([role])
}

// ── Campaign / Distribution (V0.2.0) ─────────────────────────────────

model MarketingCampaign {
  campaignId   String   @id
  name         String
  description  String?
  campaignType String   @default("daily")
  status       String   @default("draft")
  startDate    DateTime
  endDate      DateTime
  areaIds      String?
  merchantIds  String?
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  budgetFen    BigInt?
  targetGmvFen BigInt?
  targetOrders Int      @default(0)
  kpiJson      String?
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks DistributionTask[]

  @@index([status])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model CommunityGroup {
  groupId             String    @id
  groupName           String
  groupType           String    @default("wechat_group")
  areaId              String
  areaName            String?
  ownerId             String?
  ownerName           String?
  ownerPhone          String?
  memberCount         Int       @default(0)
  activityLevel       String    @default("medium")
  tags                String?
  preferredCategories String?
  preferredTimeSlots  String?
  isActive            Int       @default(1)
  source              String?
  lastActiveAt        DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tasks DistributionTask[]

  @@index([areaId])
  @@index([isActive])
  @@index([createdAt])
  @@index([areaId, createdAt])
}

model DistributionTask {
  taskId            String    @id
  campaignId        String?
  contentId         String?
  groupId           String?
  packageId         String
  channel           String    @default("wechat_group")
  title             String?
  body              String?
  cta               String?
  trackingCode      String?
  status            String    @default("draft")
  priority          String    @default("normal")
  plannedAt         DateTime?
  publishedAt       DateTime?
  completedAt       DateTime?
  cancelReason      String?
  assigneeId        String?
  assigneeName      String?
  riskLevel         String    @default("low")
  fallbackPackageId String?
  idempotencyKey    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign MarketingCampaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)
  group    CommunityGroup?    @relation(fields: [groupId], references: [groupId], onDelete: SetNull)

  executions   DistributionExecution[]
  visits       TrackingVisit[]
  attributions OrderAttribution[]
  performance  TaskPerformanceDaily[]

  @@unique([idempotencyKey])
  @@unique([trackingCode])
  @@index([status])
  @@index([plannedAt])
  @@index([campaignId])
  @@index([groupId])
  @@index([assigneeId])
  @@index([packageId])
  // List ORDER BY createdAt DESC; hourly perf/attribution ORDER BY updatedAt DESC.
  @@index([createdAt])
  @@index([updatedAt])
  // Status-filtered boards order by recency (updatedAt).
  @@index([status, updatedAt])
  // Overdue job: status = scheduled AND plannedAt <= now.
  @@index([status, plannedAt])
  // Community nested tasks: groupId = ? ORDER BY createdAt DESC.
  @@index([groupId, createdAt])
}

model DistributionExecution {
  executionId  String   @id
  taskId       String
  action       String
  operatorId   String?
  operatorName String?
  evidenceUrl  String?
  failReason   String?
  failCategory String?
  note         String?
  snapshotJson String?
  createdAt    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
  // Age-ordered retention purge (no taskId predicate).
  @@index([createdAt])
}

model TrackingVisit {
  visitId      String   @id
  taskId       String
  trackingCode String
  visitorId    String?
  referrer     String?
  ip           String?
  userAgent    String?
  visitTime    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
  // Leftmost prefix still covers equality-only trackingCode lookups.
  @@index([trackingCode, visitTime])
  // Retention purge scans by age without a trackingCode predicate.
  @@index([visitTime])
}

model OrderAttribution {
  attributionId String   @id
  taskId        String
  orderId       String
  trackingCode  String?
  method        String   @default("time_window")
  confidence    String   @default("medium")
  attributedAt  DateTime @default(now())
  isManual      Int      @default(0)
  manualReason  String?
  correctedBy   String?
  createdAt     DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, orderId])
  // One order may only belong to one task — prevents multi-claim GMV double-count.
  @@unique([orderId])
  @@index([orderId])
  // Performance job + updatePerformance day filters: taskId equality + attributedAt range.
  @@index([taskId, attributedAt])
}

model TaskPerformanceDaily {
  id              String   @id @default(cuid())
  taskId          String
  date            String
  visitCount      Int      @default(0)
  uniqueVisitors  Int      @default(0)
  orderCount      Int      @default(0)
  verifyCount     Int      @default(0)
  refundCount     Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen          BigInt?
  verifyAmountFen BigInt?
  refundAmountFen BigInt?
  conversionRate  Float    @default(0)
  computedAt      DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, date])
  // Age-ordered retention purge + range aggregates by date.
  @@index([date])
}

model OperationAuditLog {
  logId      String   @id
  userId     String?
  username   String?
  action     String
  objectType String
  objectId   String?
  before     String?
  after      String?
  result     String?
  failReason String?
  ip         String?
  createdAt  DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([objectType, objectId])
  // Filtered list ORDER BY createdAt DESC (userId / objectType windows).
  @@index([userId, createdAt])
  @@index([objectType, createdAt])
}

// ── 幂等记录（PRD §7.8 / §8.2）─────────────────────────────────
model IdempotencyRecord {
  id             String   @id
  idempotencyKey String
  operationType  String
  requestHash    String
  status         String   @default("pending") // pending, completed, failed
  responseData   String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([idempotencyKey, operationType])
  @@index([expiresAt])
}

// ── 任务运行记录（PRD §7.9 / §8.2）─────────────────────────────────
model JobRun {
  id             String    @id
  jobName        String
  status         String    @default("running") // running, success, failed
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  itemsProcessed Int       @default(0)
  errorMessage   String?
  metaJson       String?
  createdAt      DateTime  @default(now())

  @@index([jobName, startedAt])
  @@index([status])
  @@index([createdAt])
}

// ── Outbox 异步事件解耦（PRD §7.11 / §8.2）───────────────────────────
model OutboxEvent {
  id            String    @id
  aggregateType String
  aggregateId   String
  eventType     String
  payloadJson   String
  status        String    @default("pending") // pending, processed, failed
  retryCount    Int       @default(0)
  errorMessage  String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}
