generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContentPackage {
  packageId                String            @id
  packageName              String
  packageType              String
  merchantId               String
  merchantName             String
  areaId                   String
  areaName                 String
  category                 String
  originalPrice            Float
  salePrice                Float
  welfarePrice             Float?
  temporarySalePrice       Float?
  commissionRate           Float
  grossProfit              Float
  stockTotal               Int
  stockLeft                Int
  startTime                DateTime
  endTime                  DateTime
  useRules                 String
  sellingPoints            String
  saleStatus               String?
  fallbackPackageId        String?
  miniProgramPath          String
  detailSummary            String?
  merchantCooperationScore Float
  areaMatchScore           Float
  timeMatchScore           Float
  historyScore             Float
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  snapshots                SalesSnapshot[]
  scores                   PromotionScore[]
  generatedCopies          GeneratedCopy[]
  performances             CopyPerformance[]

  @@index([areaId])
  @@index([merchantId])
  @@index([saleStatus])
  @@index([category])
  @@index([areaId, saleStatus])
}

model Merchant {
  merchantId   String   @id
  merchantName String   @default("")
  areaId       String?
  areaName     String?
  address      String?  @default("")
  lat          Float?
  lng          Float?
  totalSku     Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@index([areaId])
  @@index([merchantName])
}

model SalesSnapshot {
  id               String         @id @default(cuid())
  packageId        String
  areaId           String
  merchantId       String
  snapshotTime     DateTime
  exposureCount    Int
  clickCount       Int
  orderCount       Int
  paidOrderCount   Int
  refundCount      Int
  verifyCount      Int
  gmv              Float
  paidAmount       Float
  paidAmountOnline Float          @default(0)
  paidAmountWallet Float          @default(0)
  paidAmountBonus  Float          @default(0)
  paidAmountCard   Float          @default(0)
  refundAmount     Float
  verifyAmount     Float          @default(0)
  conversionRate   Float
  verifyRate       Float
  refundRate       Float
  sellThroughRate  Float
  remainingStock   Int
  salesSpeed       Float
  createdAt        DateTime       @default(now())
  package          ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, snapshotTime])
  @@index([areaId])
  @@index([snapshotTime])
  @@index([merchantId])
}

model PromotionScore {
  id                  String         @id @default(cuid())
  packageId           String
  areaId              String
  score               Float
  level               String
  status              String
  recommendedStrategy String
  reason              String
  riskTips            String
  recommendedChannels String
  copyAngles          String
  calculatedAt        DateTime
  createdAt           DateTime       @default(now())
  package             ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, calculatedAt])
  @@index([areaId])
}

model GeneratedCopy {
  contentId       String            @id
  packageId       String
  areaId          String
  merchantId      String
  channel         String
  scenario        String
  title           String
  body            String
  cta             String
  copyVersion     String
  strategyType    String
  riskLevel       String
  riskTips        String
  auditStatus     String
  auditRemark     String?
  createdBy       String
  versionNo       Int               @default(1)
  sourceContentId String?
  isReusable      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package         ContentPackage    @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  performances    CopyPerformance[]

  @@index([auditStatus])
  @@index([packageId])
  @@index([areaId])
  @@index([auditStatus, channel])
  @@index([createdAt])
}

model CopyPerformance {
  id             String         @id @default(cuid())
  contentId      String
  packageId      String
  channel        String
  groupId        String?
  leaderId       String?
  taskId         String?
  exposureCount  Int
  clickCount     Int
  orderCount     Int
  paidOrderCount Int
  verifyCount    Int
  refundCount    Int
  gmv            Float
  conversionRate Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  package        ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  generatedCopy  GeneratedCopy? @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@index([contentId])
  @@index([packageId])
  @@index([channel])
  @@index([groupId])
}

model JeeSiteInventoryDailySnapshot {
  packageId      String
  snapshotDate   String
  snapshotTime   DateTime
  packageName    String
  merchantName   String
  areaName       String
  saleStatus     String?
  remainingStock Int
  soldOut        Boolean
  sourceField    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([packageId, snapshotDate])
  @@index([snapshotDate])
}

model OperationAlertResolution {
  alertId      String
  resolvedDate String
  resolvedBy   String?
  resolvedAt   DateTime @default(now())

  @@id([alertId, resolvedDate])
  @@index([resolvedDate])
}

model DailyMetrics {
  date             String   @id
  totalGmv         Float    @default(0)
  gmvOnline        Float    @default(0)
  gmvWallet        Float    @default(0)
  gmvBonus         Float    @default(0)
  gmvCard          Float    @default(0)
  totalRefund      Float    @default(0)
  refundRate       Float    @default(0)
  totalVerify      Float    @default(0)
  verifyRate       Float    @default(0)
  totalOrders      Int      @default(0)
  paidOrderCount   Int      @default(0)
  verifyCount      Int      @default(0)
  refundCount      Int      @default(0)
  activeMerchants  Int      @default(0)
  activeMembers    Int      @default(0)
  movingSkus       Int      @default(0)
  stagnantSkus     Int      @default(0)
  paidAmountBonus  Float    @default(0)
  paidAmountWallet Float    @default(0)
  updatedAt        DateTime @updatedAt
}

model OrderHeader {
  orderId          String    @id
  memberId         String?
  packageId        String?
  merchantId       String?
  merchantName     String?
  areaId           String?
  areaName         String?
  orderTime        DateTime
  paidTime         DateTime?
  verifyTime       DateTime?
  refundTime       DateTime?
  orderAmount      Float
  paidAmount       Float     @default(0)
  paidAmountWallet Float     @default(0)
  paidAmountBonus  Float     @default(0)
  paidAmountCard   Float     @default(0)
  refundAmount     Float     @default(0)
  verifyAmount     Float     @default(0)
  pointEarned      Int       @default(0)
  pointUsed        Int       @default(0)
  status           String
  channel          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([memberId, orderTime])
  @@index([packageId])
  @@index([orderTime])
  @@index([merchantId])
  @@index([merchantName])
  @@index([merchantName, orderTime])
  @@index([status])
  @@index([paidTime])
}

model Member {
  memberId      String    @id
  nickname      String?
  phone         String?
  level         String?
  pointsBalance Int       @default(0)
  walletBalance Float     @default(0)
  firstOrderAt  DateTime?
  lastOrderAt   DateTime?
  totalGmv      Float     @default(0)
  totalOrders   Int       @default(0)
  tags          String?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @updatedAt

  pointLedgers MemberPointLedger[]
  orderPoints  OrderPoint[]

  @@index([phone])
  @@index([lastOrderAt])
  @@index([totalGmv])
  @@index([level])
}

model MemberPointLedger {
  id         String   @id @default(cuid())
  memberId   String
  orderId    String?
  delta      Int
  balance    Int
  reason     String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@index([memberId, occurredAt])
  @@index([reason])
  @@index([orderId])
}

model OrderPoint {
  id        String   @id @default(cuid())
  orderId   String
  memberId  String
  delta     Int
  type      String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, type])
  @@index([memberId])
}

model RepurchaseCohort {
  cohortMonth   String   @id
  totalMembers  Int      @default(0)
  repeat30Count Int      @default(0)
  repeat60Count Int      @default(0)
  repeat90Count Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model MerchantDailyMetrics {
  merchantName     String
  date             String
  areaName         String?
  paidOrderCount   Int      @default(0)
  paidAmountOnline Float    @default(0)
  paidAmountWallet Float    @default(0)
  paidAmountBonus  Float    @default(0)
  paidAmountCard   Float    @default(0)
  refundAmount     Float    @default(0)
  verifyAmount     Float    @default(0)
  orderCount       Int      @default(0)
  packageCount     Int      @default(0)
  updatedAt        DateTime @updatedAt

  @@id([merchantName, date])
  @@index([date])
  @@index([merchantName, date])
}

// Daily package sales derived from inventory diffs / order ETL.
// Live DBs may still carry a legacy "revenue" column; readers prefer salesAmount.
model PackageSalesDaily {
  id          String   @id @default(cuid())
  packageId   String
  date        String
  salesQty    Int      @default(0)
  salesAmount Float    @default(0)
  refundQty   Int      @default(0)
  deltaSource String?
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([packageId, date])
  @@index([date])
  @@index([packageId, date])
}

model RuleConfig {
  id         String   @id @default(cuid())
  tenantId   String?
  merchantId String?
  type       String
  name       String
  version    Int
  isActive   Boolean
  payload    String
  comment    String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, merchantId, type])
  @@index([isActive])
}

model AppUser {
  userId       String   @id
  username     String   @unique
  passwordHash String
  displayName  String
  email        String?
  phone        String?
  isActive     Int      @default(1)
  lastLoginAt  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bindings  UserRoleBinding[]
  auditLogs OperationAuditLog[]

  @@index([username])
}

model UserRoleBinding {
  id        String   @id
  userId    String
  role      String
  scopeType String?
  scopeId   String?
  createdAt DateTime @default(now())

  user AppUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([role])
}

// ── Campaign / Distribution (V0.2.0) ─────────────────────────────────

model MarketingCampaign {
  campaignId   String   @id
  name         String
  description  String?
  campaignType String   @default("daily")
  status       String   @default("draft")
  startDate    DateTime
  endDate      DateTime
  areaIds      String?
  merchantIds  String?
  budget       Float    @default(0)
  targetGmv    Float    @default(0)
  targetOrders Int      @default(0)
  kpiJson      String?
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks DistributionTask[]

  @@index([status])
  @@index([startDate, endDate])
}

model CommunityGroup {
  groupId             String    @id
  groupName           String
  groupType           String    @default("wechat_group")
  areaId              String
  areaName            String?
  ownerId             String?
  ownerName           String?
  ownerPhone          String?
  memberCount         Int       @default(0)
  activityLevel       String    @default("medium")
  tags                String?
  preferredCategories String?
  preferredTimeSlots  String?
  isActive            Int       @default(1)
  source              String?
  lastActiveAt        DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tasks DistributionTask[]

  @@index([areaId])
  @@index([isActive])
}

model DistributionTask {
  taskId            String    @id
  campaignId        String?
  contentId         String?
  groupId           String?
  packageId         String
  channel           String    @default("wechat_group")
  title             String?
  body              String?
  cta               String?
  trackingCode      String?
  status            String    @default("draft")
  priority          String    @default("normal")
  plannedAt         DateTime?
  publishedAt       DateTime?
  completedAt       DateTime?
  cancelReason      String?
  assigneeId        String?
  assigneeName      String?
  riskLevel         String    @default("low")
  fallbackPackageId String?
  idempotencyKey    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign MarketingCampaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)
  group    CommunityGroup?    @relation(fields: [groupId], references: [groupId], onDelete: SetNull)

  executions   DistributionExecution[]
  visits       TrackingVisit[]
  attributions OrderAttribution[]
  performance  TaskPerformanceDaily[]

  @@index([status])
  @@index([plannedAt])
  @@index([campaignId])
  @@index([groupId])
  @@index([assigneeId])
}

model DistributionExecution {
  executionId  String   @id
  taskId       String
  action       String
  operatorId   String?
  operatorName String?
  evidenceUrl  String?
  failReason   String?
  failCategory String?
  note         String?
  snapshotJson String?
  createdAt    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
}

model TrackingVisit {
  visitId      String   @id
  taskId       String
  trackingCode String
  visitorId    String?
  referrer     String?
  ip           String?
  userAgent    String?
  visitTime    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
  @@index([trackingCode])
}

model OrderAttribution {
  attributionId String   @id
  taskId        String
  orderId       String
  trackingCode  String?
  method        String   @default("time_window")
  confidence    String   @default("medium")
  attributedAt  DateTime @default(now())
  isManual      Int      @default(0)
  manualReason  String?
  correctedBy   String?
  createdAt     DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, orderId])
  @@index([orderId])
}

model TaskPerformanceDaily {
  id             String   @id @default(cuid())
  taskId         String
  date           String
  visitCount     Int      @default(0)
  uniqueVisitors Int      @default(0)
  orderCount     Int      @default(0)
  verifyCount    Int      @default(0)
  refundCount    Int      @default(0)
  gmv            Float    @default(0)
  verifyAmount   Float    @default(0)
  refundAmount   Float    @default(0)
  conversionRate Float    @default(0)
  computedAt     DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, date])
}

model OperationAuditLog {
  logId      String   @id
  userId     String?
  username   String?
  action     String
  objectType String
  objectId   String?
  before     String?
  after      String?
  result     String?
  failReason String?
  ip         String?
  createdAt  DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([objectType, objectId])
}
