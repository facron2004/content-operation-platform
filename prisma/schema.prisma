model CommunityGroup {
  groupId             String    @id
  groupName           String
  groupType           String    @default("wechat_group")
  areaId              String
  areaName            String?
  ownerId             String?
  ownerName           String?
  ownerPhone          String?
  memberCount         Int       @default(0)
  activityLevel       String    @default("medium")
  tags                String?
  preferredCategories String?
  preferredTimeSlots  String?
  isActive            Int       @default(1)
  source              String?
  lastActiveAt        DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tasks DistributionTask[]

  @@index([areaId])
  @@index([isActive])
  @@index([createdAt])
  @@index([areaId, createdAt])
}

model DistributionTask {
  taskId            String    @id
  campaignId        String?
  contentId         String?
  groupId           String?
  packageId         String
  channel           String    @default("wechat_group")
  title             String?
  body              String?
  cta               String?
  trackingCode      String?
  status            String    @default("draft")
  priority          String    @default("normal")
  plannedAt         DateTime?
  publishedAt       DateTime?
  completedAt       DateTime?
  cancelReason      String?
  assigneeId        String?
  assigneeName      String?
  riskLevel         String    @default("low")
  fallbackPackageId String?
  idempotencyKey    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign MarketingCampaign? @relation(fields: [campaignId], references: [campaignId], onDelete: SetNull)
  group    CommunityGroup?    @relation(fields: [groupId], references: [groupId], onDelete: SetNull)

  executions   DistributionExecution[]
  visits       TrackingVisit[]
  attributions OrderAttribution[]
  performance  TaskPerformanceDaily[]

  @@unique([idempotencyKey])
  @@unique([trackingCode])
  @@index([status])
  @@index([plannedAt])
  @@index([campaignId])
  @@index([groupId])
  @@index([assigneeId])
  @@index([packageId])
  // List ORDER BY createdAt DESC; hourly perf/attribution ORDER BY updatedAt DESC.
  @@index([createdAt])
  @@index([updatedAt])
  // Status-filtered boards order by recency (updatedAt).
  @@index([status, updatedAt])
  // Overdue job: status = scheduled AND plannedAt <= now.
  @@index([status, plannedAt])
  // Community nested tasks: groupId = ? ORDER BY createdAt DESC.
  @@index([groupId, createdAt])
}

model DistributionExecution {
  executionId  String   @id
  taskId       String
  action       String
  operatorId   String?
  operatorName String?
  evidenceUrl  String?
  failReason   String?
  failCategory String?
  note         String?
  snapshotJson String?
  createdAt    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
  // Age-ordered retention purge (no taskId predicate).
  @@index([createdAt])
}

model TrackingVisit {
  visitId      String   @id
  taskId       String
  trackingCode String
  visitorId    String?
  referrer     String?
  ip           String?
  userAgent    String?
  visitTime    DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@index([taskId])
  // Leftmost prefix still covers equality-only trackingCode lookups.
  @@index([trackingCode, visitTime])
  // Retention purge scans by age without a trackingCode predicate.
  @@index([visitTime])
}

model OrderAttribution {
  attributionId String   @id
  taskId        String
  orderId       String
  trackingCode  String?
  method        String   @default("time_window")
  confidence    String   @default("medium")
  attributedAt  DateTime @default(now())
  isManual      Int      @default(0)
  manualReason  String?
  correctedBy   String?
  createdAt     DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, orderId])
  // One order may only belong to one task — prevents multi-claim GMV double-count.
  @@unique([orderId])
  @@index([orderId])
  // Performance job + updatePerformance day filters: taskId equality + attributedAt range.
  @@index([taskId, attributedAt])
}

model TaskPerformanceDaily {
  id              String   @id @default(cuid())
  taskId          String
  date            String
  visitCount      Int      @default(0)
  uniqueVisitors  Int      @default(0)
  orderCount      Int      @default(0)
  verifyCount     Int      @default(0)
  refundCount     Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen          BigInt?
  verifyAmountFen BigInt?
  refundAmountFen BigInt?
  conversionRate  Float    @default(0)
  computedAt      DateTime @default(now())

  task DistributionTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)

  @@unique([taskId, date])
  // Age-ordered retention purge + range aggregates by date.
  @@index([date])
}

model OperationAuditLog {
  logId      String   @id
  userId     String?
  username   String?
  action     String
  objectType String
  objectId   String?
  before     String?
  after      String?
  result     String?
  failReason String?
  ip         String?
  createdAt  DateTime @default(now())

  user AppUser? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([objectType, objectId])
  // Filtered list ORDER BY createdAt DESC (userId / objectType windows).
  @@index([userId, createdAt])
  @@index([objectType, createdAt])
}

// ── 幂等记录（PRD §7.8 / §8.2）─────────────────────────────────
model IdempotencyRecord {
  id             String   @id
  idempotencyKey String
  operationType  String
  requestHash    String
  status         String   @default("pending") // pending, completed, failed
  responseData   String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([idempotencyKey, operationType])
  @@index([expiresAt])
}

// ── 任务运行记录（PRD §7.9 / §8.2）─────────────────────────────────
model JobRun {
  id             String    @id
  jobName        String
  status         String    @default("running") // running, success, failed
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  itemsProcessed Int       @default(0)
  errorMessage   String?
  metaJson       String?
  createdAt      DateTime  @default(now())

  @@index([jobName, startedAt])
  @@index([status])
  @@index([createdAt])
}

// ── Outbox 异步事件解耦（PRD §7.11 / §8.2）───────────────────────────
model OutboxEvent {
  id            String    @id
  aggregateType String
  aggregateId   String
  eventType     String
  payloadJson   String
  status        String    @default("pending") // pending, processed, failed
  retryCount    Int       @default(0)
  errorMessage  String?
  nextRetryAt   DateTime?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status, nextRetryAt, createdAt])
  @@index([aggregateType, aggregateId])
}

