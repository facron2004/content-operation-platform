  updatedAt     DateTime               @updatedAt
  followRecords MerchantFollowRecord[]

  @@index([stage, status, updatedAt])
  @@index([regionId, stage])
  @@index([ownerUserId, nextFollowAt])
}

model MerchantFollowRecord {
  followId      String       @id @default(cuid())
  leadId        String
  operatorId    String?
  contactType   String       @default("note")
  content       String
  nextFollowAt  DateTime?
  createdAt     DateTime     @default(now())
  lead          MerchantLead @relation(fields: [leadId], references: [leadId], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Delivery {
  deliveryId       String   @id @default(cuid())
  deliveryNo       String   @unique
  orderId          String
  receiverName     String?
  receiverMobile   String?
  province         String?
  city             String?
  district         String?
  address          String?
  logisticsCompany String?
  trackingNo       String?
  status           String   @default("pending")
  exceptionReason  String?
  shippedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([orderId])
  @@index([trackingNo])
}

model CardBatch {
  batchId       String           @id @default(cuid())
  batchNo       String           @unique
  name          String
  packageId     String?
  quantity      Int
  validStartAt  DateTime?
  validEndAt    DateTime?
  status        String           @default("generated")
  createdBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cards         RedemptionCard[]

  @@index([status, createdAt])
  @@index([packageId])
}

model RedemptionCard {
  cardId           String    @id @default(cuid())
  batchId          String
  cardNo           String    @unique
  cardSecretHash   String
  secretHint       String
  status           String    @default("unused")
  activatedAt      DateTime?
  memberId         String?
  redeemedOrderId  String?
  redeemedAt       DateTime?
  validEndAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  batch            CardBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)

  @@index([batchId, status])
  @@index([status, validEndAt])
  @@index([memberId])
}
