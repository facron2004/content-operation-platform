generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum OrganizationUnitType {
  HEADQUARTERS
  REGION
  MERCHANT
}

enum RoleScopeType {
  ALL
  ORG_TREE
  ORG_ONLY
  NONE
}

// ── Tenant / organization / permission center (V0.11) ────────────────

model Tenant {
  tenantId  String    @id
  tenantKey String    @unique
  name      String
  status    String    @default("active")
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationUnits OrganizationUnit[]
  roles             Role[]
  memberships       UserOrganizationMembership[]
  roleAssignments   UserRoleAssignment[]

  @@index([status])
}

model OrganizationUnit {
  unitId     String               @id
  tenantId   String
  parentId   String?
  code       String
  name       String
  unitType   OrganizationUnitType
  areaId     String?
  merchantId String?
  isActive   Int                  @default(1)
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  tenant      Tenant                       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  parent      OrganizationUnit?            @relation("OrganizationUnitTree", fields: [parentId], references: [unitId], onDelete: Restrict)
  children    OrganizationUnit[]           @relation("OrganizationUnitTree")
  memberships UserOrganizationMembership[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, unitType, isActive])
  @@index([areaId])
  @@index([merchantId])
}

model Permission {
  permissionId String    @id
  code         String    @unique
  name         String
  description  String?
  isSystem     Int       @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([isSystem])
}

model Role {
  roleId           String    @id
  tenantId         String
  code             String
  name             String
  description      String?
  isSystemTemplate Int       @default(0)
  isActive         Int       @default(1)
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model RolePermission {
  roleId       String
  permissionId String
  granted      Int       @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role       Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserOrganizationMembership {
  membershipId String    @id
  tenantId     String
  userId       String
  orgUnitId    String
  isPrimary    Int       @default(0)
  isActive     Int       @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user    AppUser          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orgUnit OrganizationUnit @relation(fields: [orgUnitId], references: [unitId], onDelete: Cascade)

  @@unique([tenantId, userId, orgUnitId])
  @@index([userId, isActive])
  @@index([orgUnitId, isActive])
}

model UserRoleAssignment {
  assignmentId String        @id
  tenantId     String
  userId       String
  roleId       String
  scopeType    RoleScopeType @default(NONE)
  orgUnitId    String?
  isActive     Int           @default(1)
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  user    AppUser           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role    Role              @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  orgUnit OrganizationUnit? @relation(fields: [orgUnitId], references: [unitId], onDelete: SetNull)

  @@index([tenantId, userId, isActive])
  @@index([roleId, isActive])
  @@index([orgUnitId, scopeType])
}

model ContentPackage {
  packageId                String                 @id
  packageName              String
  packageType              String
  merchantId               String
  merchantName             String
  areaId                   String
  areaName                 String
  category                 String
  commissionRate           Float
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段，Phase 1 新增 / Phase 2 回填 ──
  originalPriceFen         BigInt?
  salePriceFen             BigInt?
  welfarePriceFen          BigInt?
  temporarySalePriceFen    BigInt?
  grossProfitFen           BigInt?
  stockTotal               Int
  stockLeft                Int
  startTime                DateTime
  endTime                  DateTime
  useRules                 String
  sellingPoints            String
  saleStatus               String?
  /// JeeSite 店铺 ID（drift 治理时从活加列收编，2026-07-27）
  shopId                   String?
  /// 商家地址原文（drift 治理时从活加列收编，2026-07-27）
  merchantAddress          String?
  fallbackPackageId        String?
  miniProgramPath          String
  detailSummary            String?
  merchantCooperationScore Float
  areaMatchScore           Float
  timeMatchScore           Float
  historyScore             Float
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  snapshots                SalesSnapshot[]
  scores                   PromotionScore[]
  generatedCopies          GeneratedCopy[]
  performances             CopyPerformance[]
  inventoryOperations      InventoryOperation[]
  changeRequests           ProductChangeRequest[]

  @@index([areaId])
  @@index([merchantId])
  @@index([saleStatus])
  @@index([category])
  @@index([areaId, saleStatus])
  // Hot inventory predicates: stockLeft > 0 across movement/zero-sales/overview.
  @@index([stockLeft])
  @@index([stockLeft, merchantId])
  @@index([areaId, stockLeft])
}

model Merchant {
  merchantId   String   @id
  merchantName String   @default("")
  areaId       String?
  areaName     String?
  address      String?  @default("")
  lat          Float?
  lng          Float?
  totalSku     Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  applications MerchantApplication[]

  @@index([areaId])
  @@index([merchantName])
}

model SalesSnapshot {
  id                  String         @id @default(cuid())
  packageId           String
  areaId              String
  merchantId          String
  snapshotTime        DateTime
  exposureCount       Int
  clickCount          Int
  orderCount          Int
  paidOrderCount      Int
  refundCount         Int
  verifyCount         Int
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen              BigInt?
  paidAmountFen       BigInt?
  paidAmountOnlineFen BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  conversionRate      Float
  verifyRate          Float
  refundRate          Float
  sellThroughRate     Float
  remainingStock      Int
  salesSpeed          Float
  createdAt           DateTime       @default(now())
  package             ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, snapshotTime])
  @@index([areaId])
  @@index([snapshotTime])
  @@index([merchantId])
}

model PromotionScore {
  id                  String         @id @default(cuid())
  packageId           String
  areaId              String
  score               Float
  level               String
  status              String
  recommendedStrategy String
  reason              String
  riskTips            String
  recommendedChannels String
  copyAngles          String
  calculatedAt        DateTime
  createdAt           DateTime       @default(now())
  package             ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, calculatedAt])
  @@index([areaId])
}

model GeneratedCopy {
  contentId       String            @id
  packageId       String
  areaId          String
  merchantId      String
  channel         String
  scenario        String
  title           String
  body            String
  cta             String
  copyVersion     String
  strategyType    String
  riskLevel       String
  riskTips        String
  auditStatus     String
  auditRemark     String?
  createdBy       String
  versionNo       Int               @default(1)
  sourceContentId String?
  isReusable      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  package         ContentPackage    @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  performances    CopyPerformance[]

  @@index([auditStatus])
  @@index([packageId])
  @@index([areaId])
  @@index([auditStatus, channel])
  // List filters auditStatus+channel with ORDER BY createdAt DESC (90d window).
  @@index([auditStatus, channel, createdAt])
  @@index([createdAt])
}

model CopyPerformance {
  id             String         @id @default(cuid())
  contentId      String
  packageId      String
  channel        String
  groupId        String?
  leaderId       String?
  taskId         String?
  exposureCount  Int
  clickCount     Int
  orderCount     Int
  paidOrderCount Int
  verifyCount    Int
  refundCount    Int
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  gmvFen         BigInt?
  conversionRate Float
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  package        ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)
  generatedCopy  GeneratedCopy? @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@index([contentId])
  @@index([packageId])
  @@index([channel])
  @@index([groupId])
  // Dashboard clamps reads to 90d; retention purge + age filters use createdAt.
  @@index([createdAt])
  // Dashboard package perf: packageId IN (...) ORDER BY createdAt DESC.
  @@index([packageId, createdAt])
}

model JeeSiteInventoryDailySnapshot {
  packageId      String
  snapshotDate   String
  snapshotTime   DateTime
  packageName    String
  merchantName   String
  areaName       String
  saleStatus     String?
  remainingStock Int
  soldOut        Boolean
  sourceField    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([packageId, snapshotDate])
  @@index([snapshotDate])
}

model OperationAlertResolution {
  alertId      String
  resolvedDate String
  resolvedBy   String?
  resolvedAt   DateTime @default(now())

  @@id([alertId, resolvedDate])
  @@index([resolvedDate])
}

model DailyMetrics {
  date                String   @id
  refundRate          Float    @default(0)
  verifyRate          Float    @default(0)
  totalOrders         Int      @default(0)
  paidOrderCount      Int      @default(0)
  verifyCount         Int      @default(0)
  refundCount         Int      @default(0)
  activeMerchants     Int      @default(0)
  activeMembers       Int      @default(0)
  movingSkus          Int      @default(0)
  stagnantSkus        Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  totalGmvFen         BigInt?
  gmvOnlineFen        BigInt?
  gmvWalletFen        BigInt?
  gmvBonusFen         BigInt?
  gmvCardFen          BigInt?
  totalRefundFen      BigInt?
  totalVerifyFen      BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountWalletFen BigInt?
  updatedAt           DateTime @updatedAt
}

model OrderHeader {
  orderId             String               @id
  /// JeSite 展示单号（导出「订单编号」，形如 K2026…）；主键仍是雪花 id
  orderCode           String?
  memberId            String?
  packageId           String?
  merchantId          String?
  merchantName        String?
  areaId              String?
  areaName            String?
  /// 业务员姓名（JeSite 砍价订单导出「业务员」）
  salesman            String?
  /// 上级业务员姓名（导出「上级业务员」）
  parentSalesman      String?
  /// 优惠券文案（导出「优惠券」）
  coupon              String?
  orderTime           DateTime
  paidTime            DateTime?
  verifyTime          DateTime?
  refundTime          DateTime?
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  orderAmountFen      BigInt?
  paidAmountFen       BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  pointEarned         Int                  @default(0)
  pointUsed           Int                  @default(0)
  status              String
  channel             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stateHistory        OrderStateHistory[]
  verificationRecords VerificationRecord[]
  refundRequests      RefundRequest[]
  settlementItems     SettlementItem[]
  profitSharingOrders ProfitSharingOrder[]

  @@index([memberId, orderTime])
  @@index([packageId])
  // Attribution recompute: packageId equality + orderTime range in one plan.
  @@index([packageId, orderTime])
  @@index([orderTime])
  @@index([merchantId])
  @@index([merchantName])
  @@index([merchantName, orderTime])
  @@index([orderCode])
  @@index([salesman])
  @@index([status])
  @@index([paidTime])
  // Refund/verify day totals + top-merchant metric filters.
  @@index([refundTime])
  @@index([verifyTime])
  // Direct attribution: memberId + packageId equality + orderTime range.
  @@index([memberId, packageId, orderTime])
}

model OrderStateHistory {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  reason     String
  requestId  String?
  operatorId String?
  createdAt  DateTime @default(now())

  order OrderHeader @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
  @@index([requestId])
}

model VerificationRecord {
  id               String    @id @default(cuid())
  verificationNo   String    @unique
  orderId          String
  packageId        String?
  merchantId       String?
  storeId          String?
  quantity         Int       @default(1)
  amountFen        BigInt
  verificationCode String?
  operatorId       String?
  status           String    @default("verified")
  verifiedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order           OrderHeader      @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  settlementItems SettlementItem[]

  @@index([orderId, createdAt])
  @@index([verificationCode])
  @@index([merchantId, createdAt])
}

model RefundRequest {
  id                 String    @id @default(cuid())
  refundNo           String    @unique
  orderId            String
  refundType         String
  refundAmountFen    BigInt
  status             String    @default("requested")
  reason             String
  requestedBy        String?
  approvedBy         String?
  thirdPartyRefundId String?
  requestedAt        DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  order OrderHeader @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model InventoryOperation {
  id            String   @id @default(cuid())
  requestId     String   @unique
  packageId     String
  businessType  String
  businessId    String
  operationType String
  quantity      Int
  beforeStock   Int
  afterStock    Int
  reason        String?
  createdAt     DateTime @default(now())

  package ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, createdAt])
  @@index([businessType, businessId])
}

model ProductChangeRequest {
  id           String    @id @default(cuid())
  requestNo    String    @unique
  packageId    String
  actionType   String
  beforeJson   String
  afterJson    String
  status       String    @default("requested")
  reason       String
  requestedBy  String?
  reviewedBy   String?
  reviewRemark String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  package ContentPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@index([packageId, createdAt])
  @@index([status, createdAt])
}

model MerchantApplication {
  applicationId     String    @id @default(cuid())
  applicationNo     String    @unique
  merchantId        String?
  enterpriseName    String
  contactName       String
  contactPhone      String
  licenseNo         String?
  qualificationJson String?
  storeName         String?
  storeAddress      String?
  bankAccountName   String?
  bankAccountNo     String?
  areaId            String?
  areaName          String?
  status            String    @default("submitted")
  submittedBy       String?
  reviewedBy        String?
  reviewRemark      String?
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  enabledAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant  Merchant?                @relation(fields: [merchantId], references: [merchantId], onDelete: SetNull)
  approvals MerchantApprovalAction[]

  @@index([status, createdAt])
  @@index([merchantId])
  @@index([areaId, status])
}

model MerchantApprovalAction {
  id            String   @id @default(cuid())
  applicationId String
  fromStatus    String?
  toStatus      String
  action        String
  remark        String?
  operatorId    String?
  createdAt     DateTime @default(now())

  application MerchantApplication @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Account {
  id            String   @id @default(cuid())
  ownerType     String
  ownerId       String
  assetType     String
  balance       BigInt   @default(0)
  frozenBalance BigInt   @default(0)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgers        AssetLedger[]
  benefitAccount BenefitAccount?

  @@unique([ownerType, ownerId, assetType])
  @@index([ownerType, ownerId])
  @@index([assetType, status])
}

model AssetLedger {
  id            String   @id @default(cuid())
  ledgerNo      String   @unique
  accountId     String
  businessType  String
  businessId    String
  changeType    String
  beforeBalance BigInt
  changeAmount  BigInt
  afterBalance  BigInt
  requestId     String   @unique
  operatorId    String?
  remark        String?
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([businessType, businessId])
  @@index([changeType, createdAt])
}

model Settlement {
  id                  String    @id @default(cuid())
  settlementNo        String    @unique
  merchantId          String
  periodStart         DateTime
  periodEnd           DateTime
  totalAmountFen      BigInt
  serviceFeeFen       BigInt
  settlementAmountFen BigInt
  status              String    @default("pending_approval")
  approvedBy          String?
  paidAt              DateTime?
  thirdPartyPaymentId String?
  remark              String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items SettlementItem[]

  @@index([merchantId, periodStart, periodEnd])
  @@index([status, createdAt])
}

model SettlementItem {
  id             String   @id @default(cuid())
  settlementId   String
  orderId        String
  verificationId String?
  amountFen      BigInt
  serviceFeeFen  BigInt
  netAmountFen   BigInt
  createdAt      DateTime @default(now())

  settlement   Settlement          @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  order        OrderHeader         @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  verification VerificationRecord? @relation(fields: [verificationId], references: [id], onDelete: SetNull)

  @@index([settlementId, createdAt])
  @@index([orderId])
  @@index([verificationId])
}

model ProfitSharingOrder {
  id                      String    @id @default(cuid())
  sharingNo               String    @unique
  orderId                 String
  sharingType             String
  totalAmountFen          BigInt
  platformAmountFen       BigInt
  merchantAmountFen       BigInt
  charityAmountFen        BigInt
  status                  String    @default("pending")
  thirdPartyTransactionId String?
  retryCount              Int       @default(0)
  requestId               String    @unique
  requestParamsJson       String?
  responseJson            String?
  failureReason           String?
  nextRetryAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  order OrderHeader @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, nextRetryAt, createdAt])
}

model ReconciliationBatch {
  id             String   @id @default(cuid())
  batchNo        String   @unique
  channel        String
  businessDate   String
  totalRecords   Int
  matchedRecords Int
  diffRecords    Int
  status         String   @default("matched")
  requestId      String   @unique
  createdAt      DateTime @default(now())

  diffs ReconciliationDiff[]

  @@index([channel, businessDate])
  @@index([status, createdAt])
}

model ReconciliationDiff {
  id                String    @id @default(cuid())
  batchId           String
  businessType      String
  businessId        String
  platformAmountFen BigInt
  channelAmountFen  BigInt
  diffAmountFen     BigInt
  diffType          String
  status            String    @default("open")
  resolvedBy        String?
  resolvedAt        DateTime?
  remark            String?
  createdAt         DateTime  @default(now())

  batch ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([status, createdAt])
  @@index([businessType, businessId])
}

model Member {
  memberId         String    @id
  inviteCode       String?   @unique
  parentInviteCode String?
  nickname         String?
  phone            String?
  level            String?
  pointsBalance    Int       @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  walletBalanceFen BigInt?
  totalGmvFen      BigInt?
  firstOrderAt     DateTime?
  lastOrderAt      DateTime?
  totalOrders      Int       @default(0)
  tags             String?
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @updatedAt

  pointLedgers    MemberPointLedger[]
  orderPoints     OrderPoint[]
  tagRelations    UserTagRelation[]
  audienceMembers AudienceMember[]
  userCoupons     UserCoupon[]
  benefitAccount  BenefitAccount?

  @@index([phone])
  @@index([lastOrderAt])
  @@index([level])
  @@index([parentInviteCode])
}

model MemberPointLedger {
  id         String   @id @default(cuid())
  memberId   String
  orderId    String?
  delta      Int
  balance    Int
  reason     String
  occurredAt DateTime
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@index([memberId, occurredAt])
  @@index([reason])
  @@index([orderId])
}

model OrderPoint {
  id        String   @id @default(cuid())
  orderId   String
  memberId  String
  delta     Int
  type      String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orderId, type])
  @@index([memberId])
}

model RepurchaseCohort {
  cohortMonth   String   @id
  totalMembers  Int      @default(0)
  repeat30Count Int      @default(0)
  repeat60Count Int      @default(0)
  repeat90Count Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model MerchantDailyMetrics {
  merchantName        String
  date                String
  areaName            String?
  paidOrderCount      Int      @default(0)
  // ── 统一单数口径（退款/核销率 = 单数比）：按商家×日存储退款单数/核销单数 ──
  refundCount         Int      @default(0)
  verifyCount         Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  paidAmountOnlineFen BigInt?
  paidAmountWalletFen BigInt?
  paidAmountBonusFen  BigInt?
  paidAmountCardFen   BigInt?
  refundAmountFen     BigInt?
  verifyAmountFen     BigInt?
  orderCount          Int      @default(0)
  packageCount        Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@id([merchantName, date])
  @@index([date])
  @@index([merchantName, date])
}

// Daily package sales derived from inventory diffs / order ETL.
// Live DBs may still carry a legacy "revenue" column; readers prefer salesAmount.
model PackageSalesDaily {
  id             String   @id @default(cuid())
  packageId      String
  date           String
  salesQty       Int      @default(0)
  // ── VNext 金额精度治理（PRD §7.4）：分整数影子字段 ──
  salesAmountFen BigInt?
  refundQty      Int      @default(0)
  deltaSource    String?
  computedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([packageId, date])
  @@index([date])
  @@index([packageId, date])
  // Hot "sold recently" filters: date range + salesQty > 0 (movement / zero-sales / overview).
  @@index([date, salesQty])
  @@index([packageId, salesQty, date])
}

model RuleConfig {
