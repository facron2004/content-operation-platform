{
  "name": "content-ops-ai-mvp",
  "version": "0.10.1",
  "description": "内容运营平台桌面客户端",
  "author": "Content Ops Team",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <23",
    "npm": ">=10.0.0"
  },
  "main": "apps/desktop/dist/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-unified.js",
    "desktop:dev": "npm run build && npm run build:desktop && electron apps/desktop",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:api:keepalive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/keepalive-api.ps1",
    "build": "npm run build -w @content/shared && npm run build -w @content/api && npm run build -w @content/web",
    "build:shared": "npm run build -w @content/shared",
    "build:api": "npm run build -w @content/api",
    "build:web": "npm run build -w @content/web",
    "build:desktop": "tsc -p apps/desktop/tsconfig.json",
    "build:exe": "node scripts/package-exe.js",
    "package:review": "node scripts/package-review.js",
    "package:prepare": "node scripts/prepare-api-runtime.js",
    "package:verify": "node scripts/verify-package.js",
    "package:exe": "node scripts/package-exe.js",
    "test": "npm run test -w @content/api && npm run test -w @content/web",
    "test:desktop-db": "node --import tsx --test scripts/desktop-database-lock.test.ts scripts/desktop-database-migrations.test.ts scripts/desktop-database-recovery.test.ts scripts/desktop-database-transfer.test.ts",
    "test:desktop-runtime": "node --import tsx --test scripts/desktop-runtime-security.test.ts",
    "test:governance": "node scripts/check-test-governance.mjs",
    "test:migration-history": "node --test scripts/migration-history.test.mjs",
    "test:migration-history-report": "node --test scripts/migration-history-report.test.mjs",
    "test:migration-policy": "node --test scripts/migration-policy.test.mjs scripts/database-repair.test.mjs",
    "test:db-backup": "node --test scripts/db-backup.test.mjs",
    "test:coverage": "npm run test:unit -w @content/api -- --coverage --coverage.reportsDirectory=../../.tmp/coverage-api-unit && npm run test:integration -w @content/api -- --coverage --coverage.reportsDirectory=../../.tmp/coverage-api-integration && npm run test:behavior -w @content/web -- --coverage --coverage.reportsDirectory=../../.tmp/coverage-web",
    "test:perf": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-performance.ps1",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:drift-check": "node scripts/check-schema-drift.mjs",
    "db:history-report": "node scripts/migration-history-report.mjs",
    "db:repair:diagnose": "node scripts/database-repair.mjs",
    "db:upgrade:acceptance": "tsx scripts/migration-upgrade-acceptance.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:push": "tsx prisma/create-schema.ts",
    "db:purge-mock": "tsx scripts/purge-mock-data.ts",
    "db:reconcile": "tsx scripts/reconcile-money-fen.ts",
    "db:reconcile:fix": "tsx scripts/reconcile-money-fen.ts --fix",
    "iam:backfill:report": "tsx scripts/iam-backfill-report.ts",
    "prepare:db": "npm run db:migrate",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:integrity": "node scripts/check-source-integrity.mjs",
    "start:api": "npm run start -w @content/api",
    "lint": "eslint --cache --cache-location .tmp/eslint-cache \"apps/**/*.ts\" \"apps/**/*.vue\" \"packages/**/*.ts\" --fix --max-warnings 30",
    "lint:check": "eslint --cache --cache-location .tmp/eslint-cache \"apps/**/*.ts\" \"apps/**/*.vue\" \"packages/**/*.ts\" --max-warnings 30",
    "format": "prettier --write \"apps/**/*.{ts,vue}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,vue}\" \"packages/**/*.ts\"",
    "typecheck": "npm run build -w @content/shared && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.spec.json && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "check": "npm run lint:check && npm run format:check && npm run typecheck",
    "verify": "npm run check:integrity && npm run lint:check && npm run typecheck && npm run db:validate && npm run test && npm run build",
    "test:aisenyu": "node scripts/test-aisenyu-gateway.js",
    "test:codex-aisenyu": "node scripts/test-codex-aisenyu.js",
    "setup:codex-aisenyu": "python scripts/setup-codex-aisenyu.py",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/client": "6.19.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@yao-pkg/pkg": "^6.19.0",
    "concurrently": "^9.1.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.0.0"
  }
}
