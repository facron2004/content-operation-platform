{
  "name": "content-ops-ai-mvp",
  "version": "0.1.5",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-unified.js",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:api:keepalive": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/keepalive-api.ps1",
    "build": "npm run build -w @content/shared && npm run build -w @content/api && npm run build -w @content/web",
    "build:exe": "npm run build && node scripts/package-exe.js",
    "test": "npm run test -w @content/api",
    "test:coverage": "npm run test -w @content/api -- --coverage",
    "test:perf": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-performance.ps1",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:push": "tsx prisma/create-schema.ts",
    "db:purge-mock": "tsx scripts/purge-mock-data.ts",
    "prepare:db": "npm run db:push",
    "start:api": "npm run start -w @content/api",
    "lint": "eslint \"apps/**/*.ts\" \"apps/**/*.vue\" \"packages/**/*.ts\" --fix --max-warnings 50",
    "lint:check": "eslint \"apps/**/*.ts\" \"apps/**/*.vue\" \"packages/**/*.ts\" --max-warnings 50",
    "format": "prettier --write \"apps/**/*.{ts,vue}\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,vue}\" \"packages/**/*.ts\"",
    "typecheck": "npm run build -w @content/shared && tsc --noEmit -p apps/api/tsconfig.json && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "check": "npm run lint:check && npm run format:check && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@yao-pkg/pkg": "^6.19.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vitest": "^3.0.0",
    "vue-eslint-parser": "^9.0.0"
  },
  "prisma": {}
}
